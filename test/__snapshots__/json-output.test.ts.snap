exports[`--json error reporting > puts the error object on stdout and the human text on stderr 1`] = `
{
  "error": {
    "message": "agent "code-reviewer" has conflicting definitions in claude, copilot-cli, vscode. Re-run with --prefer <target> to choose one.",
  },
}
`;

