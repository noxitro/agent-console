exports[`am doctor --json > reports findings with their target and asset 1`] = `
{
  "findings": [
    {
      "asset": "demo-skill",
      "code": "skill.non-spec-frontmatter",
      "detail": "skill "demo-skill": frontmatter field "argument-hint" is outside the agentskills.io schema",
      "level": "warn",
      "path": "<HOME>/.agents/skills/demo-skill/SKILL.md",
    },
    {
      "asset": "orphan-skill",
      "code": "skill.unmanaged-copy",
      "detail": "[copilot-cli] "orphan-skill" is a physical directory with no counterpart in the source (run \`am import --move\`)",
      "level": "warn",
      "path": "<HOME>/.copilot/skills/orphan-skill",
      "target": "copilot-cli",
    },
  ],
}
`;

